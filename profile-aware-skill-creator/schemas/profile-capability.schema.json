{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gitgotcha/my-chatgpt-skills/blob/main/profile-aware-skill-creator/schemas/profile-capability.schema.json",
  "title": "Profile Capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "domain",
    "sourceSkill",
    "dimensions",
    "evidencePolicy",
    "runtime",
    "portability"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "domain": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$",
      "not": {
        "enum": ["algorithm", "interview", "resume-knowledge", "system", "profile"]
      }
    },
    "sourceSkill": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$"
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimensionKey", "subjectKeyDescription", "description"],
        "properties": {
          "dimensionKey": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$"
          },
          "subjectKeyDescription": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordWhen",
        "doNotRecordWhen",
        "allowedOutcomes",
        "sourceRefPolicy",
        "minimumEvidenceTextLength"
      ],
      "properties": {
        "recordWhen": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "doNotRecordWhen": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowedOutcomes": {
          "const": [
            "observed",
            "consulted",
            "stuck",
            "incorrect",
            "partial",
            "completed",
            "correct",
            "passed",
            "failed"
          ]
        },
        "sourceRefPolicy": { "type": "string", "minLength": 1 },
        "minimumEvidenceTextLength": { "type": "integer", "minimum": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "capabilitiesEvent",
        "identityResolveEvent",
        "identityRegisterEvent",
        "profileReadEvent",
        "evidenceWriteEvent",
        "directDriveAccess"
      ],
      "properties": {
        "tool": { "const": "submit_event" },
        "capabilitiesEvent": { "const": "system.capabilities.read" },
        "identityResolveEvent": { "const": "system.user.resolve" },
        "identityRegisterEvent": { "const": "system.user-registered" },
        "profileReadEvent": { "const": "profile.snapshot.read" },
        "evidenceWriteEvent": { "const": "profile.evidence.recorded" },
        "directDriveAccess": { "const": false }
      }
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "coreContractDependsOnOpenaiYaml"],
      "properties": {
        "platforms": { "const": ["codex", "chatgpt", "claude", "workbuddy"] },
        "coreContractDependsOnOpenaiYaml": { "const": false }
      }
    }
  }
}
