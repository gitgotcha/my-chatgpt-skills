{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gitgotcha/my-chatgpt-skills/blob/main/profile-aware-skill-creator/schemas/profile-capability.schema.json",
  "title": "Profile Capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "domain",
    "route",
    "sourceSkill",
    "dimensions",
    "evidencePolicy",
    "runtime",
    "portability"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "domain": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$",
      "not": {
        "enum": [
          "algorithm",
          "interview",
          "resume-knowledge",
          "system",
          "profile"
        ]
      }
    },
    "route": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^/\\\\]+$"
      }
    },
    "sourceSkill": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$"
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimensionKey",
          "subjectKeyDescription",
          "description"
        ],
        "properties": {
          "dimensionKey": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$"
          },
          "subjectKeyDescription": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordWhen",
        "doNotRecordWhen",
        "allowedOutcomes",
        "sourceRefPolicy",
        "minimumEvidenceTextLength"
      ],
      "properties": {
        "recordWhen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "doNotRecordWhen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedOutcomes": {
          "const": [
            "observed",
            "consulted",
            "stuck",
            "incorrect",
            "partial",
            "completed",
            "correct",
            "passed",
            "failed"
          ]
        },
        "sourceRefPolicy": {
          "type": "string",
          "minLength": 1
        },
        "minimumEvidenceTextLength": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "readOperation",
        "writeOperation",
        "routePolicy",
        "accountIdentityResolution",
        "directDriveAccess"
      ],
      "properties": {
        "tool": {
          "const": "rds"
        },
        "readOperation": {
          "const": "snapshot.read"
        },
        "writeOperation": {
          "const": "snapshot.patch"
        },
        "routePolicy": {
          "const": "user-readable-path"
        },
        "accountIdentityResolution": {
          "const": false
        },
        "directDriveAccess": {
          "const": false
        }
      }
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platforms",
        "coreContractDependsOnOpenaiYaml"
      ],
      "properties": {
        "platforms": {
          "const": [
            "codex",
            "chatgpt",
            "claude",
            "workbuddy"
          ]
        },
        "coreContractDependsOnOpenaiYaml": {
          "const": false
        }
      }
    }
  }
}
