{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unified Interview Artifacts",
  "schema_version": "1.0",
  "$defs": {
    "CandidateSummary": {"type": "object", "required": ["schema_version", "candidate_id", "display_name", "distinguishing_note"], "properties": {"schema_version": {"const": "1.0"}, "candidate_id": {"type": "string", "pattern": "^(CAND|TEST)-[A-Za-z0-9-]+$"}, "display_name": {"type": "string", "minLength": 1}, "distinguishing_note": {"type": "string"}}},
    "Candidate": {"allOf": [{"$ref": "#/$defs/CandidateSummary"}], "properties": {"created_at": {"type": "string", "format": "date-time"}}},
    "CandidateIndex": {"type": "object", "required": ["schema_version", "candidates"], "properties": {"schema_version": {"const": "1.0"}, "candidates": {"type": "array", "items": {"$ref": "#/$defs/CandidateSummary"}}}},
    "ResumeIndex": {"type": "object", "required": ["schema_version", "candidate_id", "resumes"], "properties": {"schema_version": {"const": "1.0"}, "candidate_id": {"type": "string"}, "resumes": {"type": "array", "items": {"$ref": "#/$defs/ResumeMetadata"}}}},
    "ResumeMetadata": {"type": "object", "required": ["schema_version", "candidate_id", "resume_id", "created_at"], "properties": {"schema_version": {"const": "1.0"}, "candidate_id": {"type": "string"}, "resume_id": {"type": "string", "pattern": "^RES-"}, "created_at": {"type": "string", "format": "date-time"}}},
    "ResumeClaims": {"type": "object", "required": ["schema_version", "candidate_id", "resume_id", "claims"], "properties": {"schema_version": {"const": "1.0"}, "candidate_id": {"type": "string"}, "resume_id": {"type": "string"}, "claims": {"type": "array", "items": {"type": "object", "required": ["claim_id", "category", "content"], "properties": {"claim_id": {"type": "string", "pattern": "^CLAIM-"}, "category": {"type": "string"}, "content": {"type": "string"}, "technologies": {"type": "array", "items": {"type": "string"}}, "candidate_role": {"type": "string"}}}}}},
    "ConfirmedCandidateContext": {"type": "object", "required": ["candidate_id", "display_name", "confirmed_by_user", "confirmed_at", "active_resume_id", "selected_domain"], "properties": {"candidate_id": {"type": "string", "pattern": "^(CAND|TEST)-[A-Za-z0-9-]+$"}, "display_name": {"type": "string", "minLength": 1}, "confirmed_by_user": {"const": true}, "confirmed_at": {"type": "string", "format": "date-time"}, "active_resume_id": {"type": ["string", "null"]}, "selected_domain": {"type": ["string", "null"]}}},
    "QuestionAnswer": {"type": "object", "required": ["question_id", "domain", "source_tags", "topic_tags"], "properties": {"question_id": {"type": "string", "pattern": "^Q"}, "domain": {"type": "string"}, "source_tags": {"type": "array", "items": {"type": "string"}}, "topic_tags": {"type": "array", "items": {"type": "string"}}, "resume_claim_ids": {"type": "array", "items": {"type": "string"}}, "retest_weakness_ids": {"type": "array", "items": {"type": "string"}}, "question": {"type": "string"}, "answer": {"type": "string"}}},
    "InterviewSession": {"type": "object", "required": ["schema_version", "session_id", "candidate_id", "source_type", "evidence_type", "evidence_confidence", "questions", "state"], "properties": {"schema_version": {"const": "1.0"}, "session_id": {"type": "string", "pattern": "^(MOCK|REAL)-"}, "candidate_id": {"type": "string"}, "source_type": {"enum": ["mock_interview", "real_interview"]}, "evidence_type": {"enum": ["system_transcript", "full_transcript", "candidate_recollection"]}, "evidence_confidence": {"type": "number", "minimum": 0, "maximum": 1}, "questions": {"type": "array", "items": {"$ref": "#/$defs/QuestionAnswer"}}, "state": {"enum": ["review_pending", "reviewed", "cloud_persistence_pending"]}}},
    "Review": {"type": "object", "required": ["schema_version", "candidate_id", "session_id", "review_version", "source_type", "evidence_type", "evidence_confidence", "questions"], "properties": {"schema_version": {"const": "1.0"}, "candidate_id": {"type": "string"}, "session_id": {"type": "string"}, "review_version": {"type": "integer", "minimum": 1}, "source_type": {"enum": ["mock_interview", "real_interview"]}, "evidence_type": {"type": "string"}, "evidence_confidence": {"type": "number", "minimum": 0, "maximum": 1}, "questions": {"type": "array"}}},
    "CandidateProfile": {"type": "object", "required": ["schema_version", "candidate_id", "profile_version", "head_event_id", "domain_profiles", "general_competencies"], "properties": {"schema_version": {"const": "1.0"}, "candidate_id": {"type": "string"}, "profile_version": {"type": "integer", "minimum": 0}, "head_event_id": {"type": ["string", "null"]}, "domain_profiles": {"type": "object"}, "general_competencies": {"type": "object"}}},
    "ProfileUpdateEvent": {"type": "object", "required": ["schema_version", "event_id", "candidate_id", "session_id", "review_version", "expected_profile_version", "domain", "technical_weaknesses", "general_competencies"], "properties": {"schema_version": {"const": "1.0"}, "event_id": {"type": "string", "pattern": "^EVT-"}, "candidate_id": {"type": "string"}, "session_id": {"type": "string"}, "review_version": {"type": "integer", "minimum": 1}, "expected_profile_version": {"type": "integer", "minimum": 0}, "domain": {"type": "string"}, "technical_weaknesses": {"type": "array"}, "general_competencies": {"type": "object"}}},
    "CorrectionEvent": {"type": "object", "required": ["schema_version", "candidate_id", "superseded_session_id", "superseded_review_version", "replacement_review_version"], "properties": {"schema_version": {"const": "1.0"}, "candidate_id": {"type": "string"}, "superseded_session_id": {"type": "string"}, "superseded_review_version": {"type": "integer"}, "replacement_review_version": {"type": "integer"}}},
    "CommitRecoveryState": {"type": "object", "required": ["schema_version", "candidate_id", "session_id", "state"], "properties": {"schema_version": {"const": "1.0"}, "candidate_id": {"type": "string"}, "session_id": {"type": "string"}, "state": {"enum": ["review_pending", "cloud_persistence_pending", "profile_switch_pending", "complete"]}}}
  }
}
